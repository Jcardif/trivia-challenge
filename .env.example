# Public build-time options. Copy only the options you need to .env.local.
# Preserve any deployment-generated values already in that file.
VITE_REQUIRE_STATION_ID=false
VITE_STATION_LOCKDOWN_MESSAGE=This experience is currently unavailable. Please contact a team member for assistance.
VITE_TELEMETRY_ENABLED=true
VITE_TELEMETRY_DEBUG=false

# Rayfin generates the Fabric connection configuration during deployment.
# Backend credentials must never use a VITE_ prefix.
# See docs/deployment.md for configuring the backend secret store.
