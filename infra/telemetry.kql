.create-merge table TriviaTelemetry (eventId:string, eventType:string, type:string, eventName:string, userId:string, timestamp:datetime, properties:dynamic, context:dynamic, ingestedAtUtc:datetime)
.create-or-alter table TriviaTelemetry ingestion json mapping 'TriviaTelemetryJson' '[{"column":"eventId","Properties":{"path":"$.eventId"}},{"column":"eventType","Properties":{"path":"$.eventType"}},{"column":"type","Properties":{"path":"$.type"}},{"column":"eventName","Properties":{"path":"$.eventName"}},{"column":"userId","Properties":{"path":"$.userId"}},{"column":"timestamp","Properties":{"path":"$.timestamp"}},{"column":"properties","Properties":{"path":"$.properties"}},{"column":"context","Properties":{"path":"$.context"}},{"column":"ingestedAtUtc","Properties":{"path":"$.ingestedAtUtc"}}]'
.create-or-alter function TriviaEvents() { TriviaTelemetry | summarize arg_max(ingestedAtUtc, *) by eventId }
